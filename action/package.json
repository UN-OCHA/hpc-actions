{
  "name": "hpc-actions",
  "scripts": {
    "build": "tsc && ncc build lib/src",
    "check-formatting": "prettier -c \"./**/*.{ts,md,yml,json}\"",
    "check-types": "tsc --noEmit",
    "lint": "eslint --quiet .",
    "prepare": "git config blame.ignoreRevsFile action/.git-blame-ignore-revs && cd .. && husky action/.husky",
    "reinstall": "rm -rf node_modules/ && npm install",
    "test": "jest --config test/jest.config.js --runInBand --verbose"
  },
  "engines": {
    "node": ">=20.15.1",
    "npm": ">=9.6.5 || >=10.7.0"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@unocha/hpc-repo-tools": "^5.6.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.19.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "fp-ts": "^2.16.9",
    "io-ts": "^2.2.22",
    "isomorphic-git": "^1.29.0"
  }
}

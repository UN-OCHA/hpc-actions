{
  "name": "hpc-actions",
  "scripts": {
    "build": "tsc && ncc build lib/src",
    "check-formatting": "prettier -c \"./**/*.{ts,js,mjs,cjs,md,yml,yaml,json}\"",
    "check-types": "tsc --noEmit",
    "lint": "eslint --quiet .",
    "prepare": "git config blame.ignoreRevsFile action/.git-blame-ignore-revs && cd .. && husky action/.husky",
    "reinstall": "rm -rf node_modules/ && npm install",
    "test": "jest --config test/jest.config.js --runInBand --verbose"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.6.5 || >=10.7.0"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.16",
    "@unocha/hpc-repo-tools": "^6.3.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.23.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.2",
    "fp-ts": "^2.16.9",
    "io-ts": "^2.2.22",
    "isomorphic-git": "^1.30.1"
  }
}

{
  "name": "hpc-actions",
  "scripts": {
    "build": "tsc && ncc build lib/src",
    "check-formatting": "prettier -c \"./**/*.{ts,md,yml,json}\"",
    "check-types": "tsc --noEmit",
    "lint": "eslint --quiet --ext .ts ./",
    "prepare": "git config blame.ignoreRevsFile action/.git-blame-ignore-revs && cd .. && husky action/.husky",
    "reinstall": "rm -rf node_modules/ && npm install",
    "test": "jest --config test/jest.config.js --runInBand --verbose"
  },
  "engines": {
    "node": ">=18.20.2 || >=20.12.2",
    "npm": ">=9.6.5 || >=10.5.0"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.5.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@unocha/hpc-repo-tools": "^4.1.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.52.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "nyc": "^15.1.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.0",
    "fp-ts": "^2.16.5",
    "io-ts": "^2.2.21",
    "isomorphic-git": "^1.25.7"
  }
}
